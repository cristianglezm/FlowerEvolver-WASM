#!/bin/sh

if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	# Initial commit: diff against an empty tree object
	against=$(git hash-object -t tree /dev/null)
fi

allow_diff_versions=$(git config --type=bool hooks.allowDiffVersions)

# Redirect output to stderr.
exec 1>&2

if [ "$allow_diff_versions" != "true" ] &&
    ! bash .devops/compare_versions.sh "package.json" "pyproject.toml"
then
    cat <<\EOF
Error: You need to set the same version for npm and python

If for some reason you need to disable it, you can bypass this check using:

  git config hooks.allowDiffVersions true
EOF
    exit 1
fi


# If there are whitespace errors, print the offending file names and fail.
exec git diff-index --check --cached $against --
